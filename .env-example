POLL_INTERVAL=180
DB_URL=postgres://pwr_bot:pwr_bot@localhost:5432/pwr_bot
DB_PASS=pwr_bot
DB_USER=pwr_bot
DB_NAME=pwr_bot
DISCORD_TOKEN=discord-bot-token
DISCORD_APPLICATION_ID=1234567890
RUST_LOG=pwr_bot=info
ADMIN_ID=123
LOGS_PATH=./logs
DATA_PATH=./data
# Plugin catalog file (defaults to `$DATA_PATH/plugins.toml`). See
# `plugins.toml.example` at the repo root for the format.
# PLUGINS_TOML=./data/plugins.toml
# Directory where verified plugin binaries are installed (defaults to
# `$DATA_PATH/plugins`).
# PLUGINS_DIR=./data/plugins
ENABLE_FEED_PUBLISHER=true
ENABLE_AUTOREGISTER_CMD=true
# Comma-separated list of core plugins the host spawns at startup, in
# order. Each binary resolves to `<NAME>_PLUGIN_PATH` when set, else
# `<name>` next to the bot binary, else `DATA_PATH/<name>`. An unknown
# name or a binary that fails to spawn is skipped with a warning and the
# bot stays up.
CORE_PLUGINS=feed,voice,welcome
# Path to the feed core plugin binary (defaults to `./feed` next to the bot
# binary, then `DATA_PATH/feed`).
# FEED_PLUGIN_PATH=./data/plugins/feed
# Path to the voice core plugin binary (defaults to `./voice` next to the
# bot binary, then `DATA_PATH/voice`).
# VOICE_PLUGIN_PATH=./data/plugins/voice
# Path to the welcome core plugin binary (defaults to `./welcome` next to
# the bot binary, then `DATA_PATH/welcome`).
# WELCOME_PLUGIN_PATH=./data/plugins/welcome
