POLL_INTERVAL=180
DATABASE_PASSWORD='password'
DB_URL=postgres://pwr_bot:pwr_bot@localhost:5432/pwr_bot
DB_PASS=pwr_bot
DB_USER=pwr_bot
DB_NAME=pwr_bot
DISCORD_TOKEN=discord-bot-token
DISCORD_APPLICATION_ID=1234567890
RUST_LOG=pwr_bot=info
ADMIN_ID=123
LOGS_PATH=./logs
DATA_PATH=./data
# Plugin catalog file (defaults to `$DATA_PATH/plugins.toml`). See
# `plugins.toml.example` at the repo root for the format.
# PLUGINS_TOML=./data/plugins.toml
# Directory where verified plugin binaries are installed (defaults to
# `$DATA_PATH/plugins`).
# PLUGINS_DIR=./data/plugins
ENABLE_VOICE_TRACKING=true
ENABLE_FEED_PUBLISHER=true
ENABLE_AUTOREGISTER_CMD=true
# Path to the settings core plugin binary (defaults to `./settings` next to
# the bot binary, then `DATA_PATH/settings`).
# SETTINGS_PLUGIN_PATH=./data/plugins/settings
