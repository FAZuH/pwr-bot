%%{init: {
  'theme': 'dark',
  'themeVariables': {
    'primaryColor': '#1e1e1e',
    'primaryTextColor': '#ffffff',
    'primaryBorderColor': '#ffffff',
    'lineColor': '#ffffff',
    'secondaryColor': '#2d2d2d',
    'tertiaryColor': '#1e1e1e',
    'noteBkgColor': '#2d2d2d',
    'noteTextColor': '#ffffff',
    'noteBorderColor': '#ffffff'
  }
}}%%
graph TB
    subgraph Commands["Command Entry Points"]
        direction TB
        SettingsCmd["/settings"]
        PluginCmds["/&lt;plugin-commands&gt;<br/>discovered from PluginRegistry"]
        GuiTestCmd["/gui_test  ·  owner-only"]
    end
    
    subgraph Navigation["Navigation Flow"]
        direction TB
        
        subgraph SettingsFlow["Settings Flow"]
            direction TB
            SettingsMain["SettingsMain"]
            SettingsPlugin["SettingsPlugin { plugin_id }<br/>dynamically dispatched<br/>to plugin command"]
            SettingsAbout["SettingsAbout"]
            
            SettingsMain <-->|plugin settings<br/>from all_settings_panels| SettingsPlugin
            SettingsMain <-->|About| SettingsAbout
        end
    end
    
    subgraph PluginDispatch["Plugin Command Dispatch"]
        direction TB
        RegistryLookup["PluginRegistry.lookup(parent)"]
        FfiDispatch["invocation::dispatch()<br/>FFI invoke → ResponsePayload"]
        DiscordReply["Discord Reply<br/>content · ephemeral"]
        RegistryLookup --> FfiDispatch --> DiscordReply
    end
    
    Commands -->|settings| SettingsMain
    Commands -->|plugin command| RegistryLookup
    
    style SettingsMain fill:#2d2d2d,stroke:#ffffff,stroke-width:3px
    style SettingsPlugin fill:#1e1e1e,stroke:#ffffff
    style SettingsAbout fill:#1e1e1e,stroke:#ffffff
    style RegistryLookup fill:#1e1e1e,stroke:#34d399
    style FfiDispatch fill:#1e1e1e,stroke:#34d399
    style PluginCmds fill:#1e1e1e,stroke:#34d399
