%%{init: {
  'theme': 'dark',
  'themeVariables': {
    'primaryColor': '#1e1e1e',
    'primaryTextColor': '#ffffff',
    'primaryBorderColor': '#ffffff',
    'lineColor': '#ffffff',
    'secondaryColor': '#2d2d2d',
    'tertiaryColor': '#1e1e1e',
    'noteBkgColor': '#2d2d2d',
    'noteTextColor': '#ffffff',
    'noteBorderColor': '#ffffff'
  }
}}%%
graph TB
    subgraph HostLoop["TEA Host Event Loop (rt.rs)"]
        direction TB

        Start["Start Host"]
        BuildModel["Build Model<br/>(Feature::initial)"]
        BootUpdate["Apply start_msg<br/>(Feature::update)"]
        Render["Render View<br/>(Feature::view + attachments)"]
        StartCollectors["ViewChannel::start()<br/>(spawn background collectors)"]
        Recv["Loop: select on<br/>ViewChannel::recv() + fx channel"]

        Component["Component Interaction<br/>(Discord UI)"]
        FxMsg["Effect Follow-up Msg<br/>(fx channel)"]
        OtherEvt["Modal / Message / Reaction"]
        Timeout["Timeout Event"]

        Unknown["Unknown custom_id?"]
        Skip["Acknowledge & Skip"]
        ModalHook["open_modal?"]
        SkipModal["Skip ack + render<br/>(modal owns the interaction)"]

        Translate["Feature::translate<br/>(action + select values → Msg)"]
        OnEvent["Feature::on_event<br/>(non-component → Msg)"]
        Apply["Feature::update<br/>(pure → effects)"]
        ExecEffects["EffectHandler::execute<br/>(only IO)"]
        ExitNav["exit_navigation?"]

        Start --> BuildModel
        BuildModel --> BootUpdate
        BootUpdate --> Render
        Render -->|msg_id known| StartCollectors
        StartCollectors -->|loop| Recv

        Recv -->|ComponentInteraction| Component
        Recv -->|fx message| FxMsg
        Recv -->|Modal/Message/Reaction| OtherEvt
        Recv -->|Timeout| Timeout

        Component --> Unknown
        Unknown -->|yes| Skip
        Unknown -->|no| ModalHook
        ModalHook -->|yes| SkipModal
        ModalHook -->|no| Translate
        Translate -->|None| Skip
        Translate -->|Some| Apply
        OtherEvt --> OnEvent
        OnEvent -->|None| Recv
        OnEvent -->|Some| Apply
        FxMsg --> Apply
        Apply --> ExecEffects
        ExecEffects --> ExitNav
        ExitNav -->|navigate| Stop[Stop Host]
        ExitNav -->|none| Render
        Timeout -->|timeout_msg → apply| TimeoutNav["exit_navigation?"]
        TimeoutNav -->|navigate| Stop
        TimeoutNav -->|none| Stop

        Skip -->|next event| Recv
        SkipModal -->|next event| Recv
        Render -->|edited live message| Recv
    end

    subgraph Collectors["Background Collectors (spawned by ViewChannel)"]
        direction TB
        CompCollector["ComponentInteractionCollector"]
        ModalCollector["ModalInteractionCollector"]
        MsgCollector["MessageCollector"]
        ReactCollector["ReactionCollector"]

        CompCollector -->|lookup registry| CompSend["send (Some(action), Component)"]
        ModalCollector -->|lookup registry| ModalSend["send (Some(action), Modal)"]
        MsgCollector --> MsgSend["send (None, Message)"]
        ReactCollector --> ReactSend["send (None, Reaction)"]

        CompCollector -->|timeout| TimeoutSend["send (None, Timeout)"]
    end

    Collectors -.->|feed into| Recv

    subgraph TEAPattern["TEA Update Pattern (inside Host::apply)"]
        direction TB
        Parse["Feature::translate / on_event<br/>action + values into Msg"]
        Update["Feature::update(msg, model)<br/>→ effects (data)"]
        Model[(Model)]
        Effects[(Effects)]
        SideEffects["EffectHandler::execute<br/>(db fetch, persist, render)"]

        Parse --> Update
        Model --> Update
        Update --> Effects
        Effects --> SideEffects
    end

    TEAPattern -.->|executed by| Apply

    subgraph FeatureContract["GuiFeature Contract"]
        direction TB
        Initial["initial(config) → Model"]
        ViewFn["view(&Model) → components<br/>(pure, no IO)"]
        TranslateFn["translate(action, values) → Msg"]
        ExitFn["exit_navigation(msg) → Navigation?"]

        Initial --> ViewFn
        ViewFn --> TranslateFn
        TranslateFn --> ExitFn
    end

    FeatureContract -.->|implemented by| Apply

    style Start fill:#2d2d2d,stroke:#ffffff,stroke-width:2px
    style Stop fill:#2d2d2d,stroke:#ffffff,stroke-width:2px
    style Render fill:#1e1e1e,stroke:#ffffff
    style Recv fill:#1e1e1e,stroke:#ffffff
    style BuildModel fill:#1e1e1e,stroke:#ffffff
    style StartCollectors fill:#1e1e1e,stroke:#ffffff
    style TEAPattern fill:#1a3a1a,stroke:#4ade80,stroke-width:2px
    style Parse fill:#2d2d2d,stroke:#4ade80
    style Update fill:#2d2d2d,stroke:#4ade80
    style SideEffects fill:#2d2d2d,stroke:#4ade80
