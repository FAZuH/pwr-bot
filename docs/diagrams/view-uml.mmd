  }
}}%%
classDiagram
    %% ── Core structs ──────────────────────────────────────────────
    class ActionRegistry~T~ {
        actions: HashMap~String, T~
        prefix: String
        counter: usize
        register(action: T) RegisteredAction
        register_with_id(id, action) Option~RegisteredAction~
        get(id: str) Option~&T~
        clear()
    }

    class ViewChannel~T~ {
        tx: UnboundedSender~EventMessage~T~~
        rx: UnboundedReceiver~EventMessage~T~~
        registry: Registry~T~
        config: ViewChannelConfig
        new(config, registry)
        recv() Option~EventMessage~T~~
        start(ctx, msg_id, author_id, channel_id, timeout)
    }

    class ViewChannelConfig {
        components: bool
        modals: bool
        messages: bool
        reactions: bool
    }

    class RegisteredAction {
        id: String
        label: str
        as_button() CreateButton
        as_select(kind) CreateSelectMenu
        as_select_option() CreateSelectMenuOption
    }

    class Router {
        ctx: Context
        nav_queue: Mutex~VecDeque~Navigation~~
        reply_handle: SharedReplyHandle
        context() Context
        navigate(next)
        run(initial)
    }

    class Navigation {
        <<enum>>
        Back
        Exit
        SettingsMain
        ...
    }

    class ViewEvent {
        <<enum>>
        Component(ComponentInteraction)
        Modal(ModalInteraction)
        Message(Message)
        Reaction(Reaction)
        Async
        Timeout
    }

    class SelectValues {
        <<enum>>
        String(Vec~String~)
        Channel(Vec~GenericChannelId~)
        Role(Vec~RoleId~)
        User(Vec~UserId~)
    }

    %% ── Type aliases ──────────────────────────────────────────────
    class EventMessage~T~ {
        <<type alias>>
        Tuple of Option~T~ and ViewEvent
    }

    class Registry~T~ {
        <<type alias>>
        Arc wrapping RwLock of ActionRegistry~T~
    }

    %% ── Traits ────────────────────────────────────────────────────
    class Action {
        <<trait>>
        label() str
    }

    class GuiFeature {
        <<trait>>
        type Action: Action
        update(msg, model) Vec~Effect~
        view(model, registry) Vec~CreateComponent~
        translate(action, values) Option~Msg~
        on_event(event, model) Option~Msg~
        open_modal(action, ctx, interaction, tx) bool
    }

    class Update {
        <<trait>>
        type Model
        type Msg
        type Cmd
        update(msg, model) Cmd
    }

    class CommandHandler {
        <<trait>>
        run(router: Arc~Router~) Result
    }

    %% ── Relationships ─────────────────────────────────────────────
    ViewChannel --> ActionRegistry : reads
    ActionRegistry ..> Action : maps
    ActionRegistry ..> RegisteredAction : produces
    Router ..> CommandHandler : drives
    CommandHandler ..> Navigation : returns
    GuiFeature ..> SelectValues : uses
