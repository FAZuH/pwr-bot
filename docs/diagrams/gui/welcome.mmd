---
config:
  layout: elk
  class:
    hideEmptyMembersBox: true
---
classDiagram
    direction LR
    class GuiFeature { <<Trait>> }
    class WelcomeFeature
    class Host~F,H~
    class EffectHandler { <<Trait>> }
    class WelcomeSettingsEffectHandler
    class WelcomeSettingsModel
    class WelcomeSettingsMsg {
        <<enumeration>>
        Start
        Expired
        ToggleEnabled
        SetChannel
        SetTemplate
        MarkRemoval
        AddMessage
        SetColor
        SaveRemoval
        CancelRemoval
        Back
        About
        ImageRendered
        SettingsPersisted
    }
    class WelcomeSettingsEffect {
        <<enumeration>>
        PersistSettings
        RenderImage
    }
    class SettingsWelcomeAction {
        <<enumeration>>
        ToggleEnabled
        ChannelSelect
        TemplateSelect
        SetColor
        MarkRemoval
        AddMessage
        SaveRemoval
        CancelRemoval
        Back
        About
    }
    class ServerSettings
    class WelcomeImageGenerator
    class ActionRegistry
    class ViewChannel
    class Router

    GuiFeature <|.. WelcomeFeature
    Host --> WelcomeFeature : F
    Host ..> WelcomeFeature : open_modal
    Host --> WelcomeSettingsEffectHandler : H
    WelcomeSettingsEffectHandler ..|> EffectHandler
    WelcomeFeature ..> WelcomeSettingsModel : Model
    WelcomeFeature ..> WelcomeSettingsMsg : Msg
    WelcomeFeature ..> WelcomeSettingsEffect : Effect
    WelcomeFeature ..> SettingsWelcomeAction : Action
    WelcomeSettingsModel *-- ServerSettings
    WelcomeSettingsEffectHandler --> WelcomeImageGenerator : preview
    Host --> ViewChannel : collects events
    Host --> ActionRegistry : custom_ids
    Host --> Router : navigate
