---
config:
  layout: elk
  class:
    hideEmptyMembersBox: true
---
classDiagram
    direction LR
    class GuiFeature { <<Trait>> }
    class FeedSettingsFeature
    class Host~F,H~
    class EffectHandler { <<Trait>> }
    class FeedSettingsEffectHandler
    class FeedSettingsModel
    class FeedSettingsMsg {
        <<enumeration>>
        Start
        Expired
        ToggleEnabled
        SetChannel
        SetSubRole
        SetUnsubRole
        Back
        About
    }
    class FeedSettingsEffect {
        <<enumeration>>
        PersistSettings
    }
    class SettingsFeedAction {
        <<enumeration>>
        Enabled
        Channel
        SubRole
        UnsubRole
        Back
        About
    }
    class ServerSettings
    class FeedSubscriptionProvider { <<Trait>> }
    class ActionRegistry
    class ViewChannel
    class Router

    GuiFeature <|.. FeedSettingsFeature
    Host --> FeedSettingsFeature : F
    Host --> FeedSettingsEffectHandler : H
    FeedSettingsEffectHandler ..|> EffectHandler
    FeedSettingsFeature ..> FeedSettingsModel : Model
    FeedSettingsFeature ..> FeedSettingsMsg : Msg
    FeedSettingsFeature ..> FeedSettingsEffect : Effect
    FeedSettingsFeature ..> SettingsFeedAction : Action
    FeedSettingsModel *-- ServerSettings
    FeedSettingsEffectHandler --> FeedSubscriptionProvider : persist settings
    Host --> ViewChannel : collects events
    Host --> ActionRegistry : custom_ids
    Host --> Router : navigate
