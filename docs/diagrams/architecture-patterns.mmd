%%{init: {
  'theme': 'dark',
  'themeVariables': {
    'primaryColor': '#1e1e1e',
    'primaryTextColor': '#ffffff',
    'primaryBorderColor': '#ffffff',
    'lineColor': '#888888',
    'secondaryColor': '#2d2d2d',
    'tertiaryColor': '#1e1e1e'
  }
}}%%
graph LR
    subgraph CommandRegistration["Command Registration"]
        direction TB
        Cogs2["Cogs<br/>core commands"]
        PluginReg["PluginRegistry"]
        FFILoader["FFI Loader<br/>dlopen .so → vtable"]
        PluginMetadata["PluginMetadata<br/>commands · panels · tasks<br/>events · test steps"]
        AllCmds["Combined Command List<br/>→ Poise Framework"]
        Cogs2 --> AllCmds
        FFILoader --> PluginMetadata
        PluginMetadata --> PluginReg
        PluginReg -->|all_commands| AllCmds
    end

    subgraph PluginDiscovery["Plugin Discovery Methods"]
        direction TB
        Registry["PluginRegistry"]
        Cmds["all_commands() → Vec~Command~"]
        Panels["all_settings_panels() → Vec~SettingsPanelSpec~"]
        Events["all_event_handlers() → Vec~EventHandlerSpec~"]
        Steps["all_test_steps() → Vec~TestStepSpec~"]
        Tasks["all_tasks() → Vec~TaskSpec~"]
        Registry --> Cmds & Panels & Events & Steps & Tasks
    end

    subgraph RouterHandler["Router → CommandHandler"]
        direction TB
        Entry["Entry fn<br/>command handler"]
        Router["Router<br/>navigation loop"]
        Handler["CommandHandler<br/>run()"]
        View2["ViewEngine<br/>run()"]
        Nav["Navigation<br/>Back · Exit · Settings*"]
        Entry --> Router -->|drives| Handler
        Handler --> View2
        Handler -->|calls navigate| Nav
        Nav -.->|queued in| Router
    end

    subgraph TEA["TEA Update Pattern"]
        direction TB
        Msg["Msg enum<br/>user intent"]
        Model[(Model<br/>view state)]
        Upd["Update trait<br/>update(msg, model) → Cmd"]
        Cmd["Cmd enum<br/>side-effect instruction"]
        Handler2["ViewHandler<br/>parse → update → execute"]
        
        Handler2 -->|builds| Msg
        Msg --> Upd
        Model --> Upd
        Upd --> Cmd
        Cmd --> Handler2
    end

    subgraph PubSub["Pub/Sub"]
        direction TB
        Pub["Publisher<br/>BotEventHandler · Plugins"]
        Bus["EventBus"]
        S1["Plugin EventHandler A"]
        S2["Plugin EventHandler B"]
        Pub -->|publish_named| Bus
        Bus -->|dispatch| S1 & S2
    end

    subgraph FFIDispatch["FFI Plugin Dispatch"]
        direction TB
        CmdName["Command Name"]
        RegLookup["PluginRegistry.lookup()"]
        LoadedPlugin["LoadedPlugin.vtable"]
        FfiHost["FfiHostCtx<br/>handle + callbacks"]
        InvokeReq["InvokeRequest<br/>command · args · callbacks"]
        InvokeResp["InvokeResponse<br/>payload · error"]
        DiscordReply["Discord Reply"]
        CmdName --> RegLookup --> LoadedPlugin
        LoadedPlugin --> FfiHost --> InvokeReq
        InvokeReq -->|vtable.invoke| InvokeResp --> DiscordReply
    end

    subgraph TestPat["Automated GUI Testing"]
        direction TB
        GuiTestCmd["/gui_test<br/>owner-only command"]
        CoreSteps["Core Test Steps<br/>about · settings"]
        PluginStepSpecs["Plugin TestStepSpecs<br/>registry.all_test_steps()"]
        StepRunner["Generic Runner<br/>dispatch_plugin_command()"]
        GuiTestCmd --> CoreSteps & PluginStepSpecs
        PluginStepSpecs --> StepRunner
    end

    subgraph RepoPat["Repos Factory Pattern"]
        direction TB
        BusinessLogic["Service Layer"]
        RepTrait["Repos trait"]
        Tables["PgServerSettingsRepo<br/>PgBotMetaRepo"]
        DB["PostgreSQL / Diesel"]
        BusinessLogic --> RepTrait --> Tables --> DB
    end

    style RouterHandler fill:#1a2a3a,stroke:#818cf8,stroke-width:2px
    style TEA fill:#1a3a1a,stroke:#4ade80,stroke-width:2px
    style PubSub fill:#1a3a3a,stroke:#2dd4bf,stroke-width:2px
    style RepoPat fill:#2a1a1a,stroke:#f87171,stroke-width:2px
    style FFIDispatch fill:#1a2a1a,stroke:#34d399,stroke-width:2px
    style CommandRegistration fill:#2a1a2a,stroke:#fbbf24,stroke-width:2px
    style TestPat fill:#1a2a3a,stroke:#818cf8,stroke-width:2px
    style PluginDiscovery fill:#1a2a1a,stroke:#34d399,stroke-width:2px

    style Bus fill:#2d2d2d,stroke:#2dd4bf
    style RepTrait fill:#2d2d2d,stroke:#f87171
    style Registry fill:#2d2d2d,stroke:#34d399
    style FFILoader fill:#2d2d2d,stroke:#fbbf24
    style PluginMetadata fill:#2d2d2d,stroke:#fbbf24
