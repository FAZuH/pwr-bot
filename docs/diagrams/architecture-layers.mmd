%%{init: {
  'theme': 'dark',
  'themeVariables': {
    'primaryColor': '#1e1e1e',
    'primaryTextColor': '#ffffff',
    'primaryBorderColor': '#ffffff',
    'lineColor': '#888888',
    'secondaryColor': '#2d2d2d',
    'tertiaryColor': '#1e1e1e'
  }
}}%%
graph TB
    subgraph Presentation["Presentation Layer  ·  src/bot/"]
        direction TB
        Bot["Bot<br/>Serenity + Poise"]
        EventHandler["BotEventHandler<br/>Gateway events"]

        subgraph Commands["Command Registration"]
            Cogs["Cogs (Aggregator)<br/>Core commands"]
            PluginRegistry["PluginRegistry<br/>all_commands()"]
            CoreCmds["Core Commands<br/>settings · about · register · ..."]
            PluginCmds["Plugin Commands<br/>dynamically discovered"]
            Cogs --> CoreCmds
            PluginRegistry --> PluginCmds
        end

        subgraph Nav["Router → Handler Flow"]
            Router["Router<br/>context + state"]
            Handlers["CommandHandlers<br/>run() → Navigation"]
            Views["Views<br/>ViewRender / ViewHandler / ViewEngine"]
            Router --> Handlers --> Views
        end

        subgraph TestFW["Test Framework  ·  src/bot/test_framework/"]
            TestRunner["GuiTestRunner<br/>/gui_test command"]
            PluginTestSteps["Plugin Test Steps<br/>registry.all_test_steps()"]
            SimEvents["SyntheticEvent<br/>simulate_click / simulate_select"]
            TestAsserts["assert_has_action<br/>assert_navigated_to"]
            TestRunner --> PluginTestSteps --> SimEvents --> Views
            TestRunner --> TestAsserts
        end

        subgraph PluginSystem["Plugin System  ·  src/bot/plugin/"]
            Loader["loader::load_plugins<br/>dlopen .so files"]
            Registry["PluginRegistry<br/>register · lookup · discovery"]
            Invocation["invocation::dispatch<br/>FFI invoke → host callbacks"]
            FfiHost["FfiHostCtx<br/>handle-based callback registry"]
            Loader --> Registry --> Invocation
            Invocation --> FfiHost
        end

        Bot --> EventHandler & Cogs
        CoreCmds & PluginCmds --> Router
    end

    subgraph Application["Application Layer  ·  src/event/"]
        direction TB

        subgraph EventSystem["Event System  ·  Pub/Sub"]
            EventBus["EventBus"]
            VoiceEvent["VoiceStateEvent<br/>(named 'voice_state')"]
            EventBus --> VoiceEvent
        end

        EventBus -->|plugin subscriptions| Presentation
    end

    subgraph BusinessLogic["Business Logic Layer  ·  src/service/  src/update/"]
        direction TB
        
        subgraph UpdateSystem["TEA Update  ·  Pure Business Logic"]
            UpdateTrait["Update trait<br/>Model + Msg + Cmd"]
            SettingsUpd["SettingsMainUpdate"]
            PluginUpd["Plugin Updates<br/>(in plugin crates)"]
            UpdateTrait -.->|implemented by| SettingsUpd
            UpdateTrait -.->|implemented by| PluginUpd
        end
        
        SettingsService["SettingsService<br/>get · update"]
        InternalService["InternalService"]
    end

    subgraph Domain["Domain Layer  ·  src/entity.rs"]
        Entities["Domain Entities<br/>ServerSettingsEntity (HashMap-based)<br/>BotMetaEntity"]
    end

    subgraph Infrastructure["Infrastructure Layer  ·  src/repo/"]
        subgraph Repository["Repos Factory Pattern"]
            Repo["PgRepos + Repos trait<br/>factory"]
            SettingsRepo["PgServerSettingsRepo"]
            BotMetaRepo["PgBotMetaRepo"]
            Repo --> SettingsRepo & BotMetaRepo
        end
        PostgreSQL["PostgreSQL  ·  Diesel async"]
        SettingsRepo & BotMetaRepo --> PostgreSQL
    end

    subgraph Plugins["Plugin Crates  ·  crates/pwr-bot-plugin-*/"]
        direction TB
        PluginsDB["Plugin DB Pools<br/>deadpool-postgres<br/>reads DB_URL directly"]
        PluginsTables["Plugin Tables<br/>feeds · feed_items · subscribers<br/>voice_sessions · ..."]
        PluginsDB --> PluginsTables
    end

    Config["Config<br/>env vars + feature flags"]

    %% Cross-layer
    Handlers --> BusinessLogic
    Views --> UpdateSystem
    SettingsService --> Repository
    Bot --> BusinessLogic & EventBus
    Config --> Bot & Plugins
    PluginsDB --> PostgreSQL
    PluginSystem --> Plugins

    style Presentation fill:#1a3a1a,stroke:#4ade80,stroke-width:2px
    style Application fill:#1a2a3a,stroke:#60a5fa,stroke-width:2px
    style BusinessLogic fill:#3a1a3a,stroke:#c084fc,stroke-width:2px
    style Domain fill:#3a2a1a,stroke:#fbbf24,stroke-width:2px
    style Infrastructure fill:#2a1a1a,stroke:#f87171,stroke-width:2px
    style Config fill:#1a1a2a,stroke:#a78bfa,stroke-width:2px
    style Plugins fill:#1a2a1a,stroke:#34d399,stroke-width:2px
    style UpdateSystem fill:#1a3a1a,stroke:#4ade80,stroke-width:2px
    style PluginSystem fill:#1a2a1a,stroke:#34d399,stroke-width:2px

    style Bot fill:#2d2d2d,stroke:#4ade80
    style EventBus fill:#2d2d2d,stroke:#60a5fa
    style Repo fill:#2d2d2d,stroke:#f87171
    style Registry fill:#2d2d2d,stroke:#34d399
    style Loader fill:#2d2d2d,stroke:#34d399
    style Invocation fill:#2d2d2d,stroke:#34d399
    style UpdateTrait fill:#2d2d2d,stroke:#4ade80
